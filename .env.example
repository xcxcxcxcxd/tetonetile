# Copy to .env and adjust. Every value is optional.
PORT=3000
HOST=0.0.0.0
# Database, uploads and automatic backups
DATA_DIR=./data
# Address printed in every QR label - the address phones use to reach the app
PUBLIC_URL=http://192.168.1.20:3000
# Behind HTTPS / a reverse proxy:
# SECURE_COOKIES=1
# TRUST_PROXY=1
SESSION_DAYS=30
